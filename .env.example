# ── Cloudflare ────────────────────────────────────────────────────────────────
# Find at: dash.cloudflare.com → your account → Overview (right sidebar)
CLOUDFLARE_ACCOUNT_ID=

# ── Akto ──────────────────────────────────────────────────────────────────────
# Find at: Akto Dashboard → Settings → Account  (default: 1000000)
AKTO_ACCOUNT_ID=1000000

# Akto API token — used as DATABASE_ABSTRACTOR_SERVICE_TOKEN in mini-runtime and guardrails-executor
# Find at: Akto Dashboard → Quick Start → Hybrid SaaS → Connect → Copy Token
AKTO_API_TOKEN=

# ── Proxy route ───────────────────────────────────────────────────────────────
# Cloudflare route the proxy intercepts. Examples:
#   api.yourdomain.com/*   or   *.yourdomain.com/*
ROUTE_PATTERN=yourdomain.com/*

# Guardrails mode: async (default) or blocked
#   async   — proxy first, run guardrails after response is sent (zero added latency)
#   blocked — validate request + response before returning; returns 400 if blocked
GUARDRAILS_MODE=async

# ── Image push ────────────────────────────────────────────────────────────────
# Version tag for Docker images pushed to Cloudflare registry.
# Cloudflare does NOT allow overwriting an existing tag — use a new value each push.
# Images pulled from DockerHub and pushed to Cloudflare registry:
#   aktosecurity/mini-runtime:local              → mini-runtime:<tag>
#   aktosecurity/data-ingestion-service:latest   → data-ingestion-service:<tag>
#   aktosecurity/akto-guardrails-service:local   → guardrails-service:<tag>
#   aktosecurity/akto-agent-guard-executor:local → agent-guard-executor:<tag>
IMAGE_TAG=v1
