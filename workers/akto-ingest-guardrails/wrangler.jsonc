{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "akto-ingest-guardrails-cf",
	"main": "src/index.ts",
	"compatibility_date": "2025-05-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"preview_urls": false,

	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	},

	"containers": [
		{
			"name": "akto-data-ingestion-container-cf",
			"class_name": "AktoDataIngestionContainerCf",
			"image": "registry.cloudflare.com/YOUR_ACCOUNT_ID/data-ingestion-service:v1",
			"instance_type": "standard-1",
			"max_instances": 10
		}
	],

	"durable_objects": {
		"bindings": [
			{
				"class_name": "AktoDataIngestionContainerCf",
				"name": "AKTO_DATA_INGESTION_CONTAINER_CF"
			}
		]
	},

	"migrations": [
		{
			"new_sqlite_classes": [
				"AktoDataIngestionContainerCf"
			],
			"tag": "v1"
		}
	],

	"services": [
		{
			"binding": "AKTO_GUARDRAILS_SERVICE",
			"service": "akto-guardrails-service-cf"
		},
		{
			"binding": "AKTO_MINI_RUNTIME_WORKER",
			"service": "akto-mini-runtime-cf"
		}
	],

	"vars": {
		"ENABLE_MCP_GUARDRAILS": "true"
	}

	// Secrets (set via CLI):
	//   wrangler secret put DATABASE_ABSTRACTOR_SERVICE_TOKEN
}
