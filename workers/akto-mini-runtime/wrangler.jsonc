{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "akto-mini-runtime-cf",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,

	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	},

	"containers": [
		{
			"name": "akto-mini-runtime-container-cf",
			"class_name": "AktoMiniRuntimeContainerCf",
			"image": "registry.cloudflare.com/YOUR_ACCOUNT_ID/mini-runtime:v1",
			"instance_type": "standard-2",
			"max_instances": 3
		}
	],

	"durable_objects": {
		"bindings": [
			{
				"class_name": "AktoMiniRuntimeContainerCf",
				"name": "AKTO_MINI_RUNTIME_CONTAINER_CF"
			}
		]
	},

	"migrations": [
		{
			"new_sqlite_classes": [
				"AktoMiniRuntimeContainerCf"
			],
			"tag": "v1"
		}
	],

	"vars": {
		"DATABASE_ABSTRACTOR_SERVICE_URL": "https://ultron.akto.io",
		"AKTO_INSTANCE_TYPE": "RUNTIME",
		"RUNTIME_MODE": "hybrid",
		"MINI_RUNTIME_NAME": "mini-runtime-cf"
	}

	// Secrets (set via CLI):
	//   wrangler secret put DATABASE_ABSTRACTOR_SERVICE_TOKEN
}
