{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "akto-cloudflare-proxy-cf",
	"main": "src/index.js",
	"compatibility_date": "2025-06-23",

	"observability": {
		"enabled": true,
		"logs": {
		"enabled": true,
		"invocation_logs": true
		},
		"traces": {
		"enabled": true
		}
	},

	// Route rule — deploy.sh replaces pattern/zone_name from ROUTE_PATTERN,
	// or removes this block entirely if ROUTE_PATTERN is empty.,

	"services": [
		{
			// akto-ingest-guardrails must be deployed before this worker.
			// Handles traffic ingestion (/api/ingestData) and guardrails (/api/http-proxy).
			"binding": "AKTO_INGESTION_WORKER",
			"service": "akto-ingest-guardrails-cf"
		}
	],

	"vars": {
		// Set to "true" to enable guardrails. Requires akto-ingest-guardrails deployed.
		"APPLY_AKTO_GUARDRAILS": "true",

		// Guardrails mode: "async" (default) or "blocked".
		//   async:   proxy first, run guardrails+ingest after response is sent (non-blocking)
		//   blocked: validate request, proxy, validate response — returns 400 if blocked
		"AKTO_GUARDRAILS_MODE": "async",

		// Optional: comma-separated path substrings to apply guardrails on.
		// Leave empty to guard all endpoints. Example: "/api/chat,/api/completions"
		"AKTO_ENDPOINTS_TO_GUARD": "",

		// Your Akto account ID. Find it in: Akto Dashboard → Settings → Account.
		"AKTO_ACCOUNT_ID": "1000000"
	}
}
