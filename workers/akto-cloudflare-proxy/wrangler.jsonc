{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "akto-cloudflare-proxy",
	"main": "src/index.js",
	"compatibility_date": "2025-06-23",
	"observability": {
		"enabled": true
	},

	"services": [
		{
			// akto-ingest-guardrails must be deployed before this worker.
			// Handles both traffic ingestion (/api/ingestData) and guardrails
			// validation (/api/validate/request, /api/validate/response).
			"binding": "AKTO_INGESTION_WORKER",
			"service": "akto-ingest-guardrails"
		}
	],

	"vars": {
		// Set to "true" to enable request guardrails (blocking + redaction).
		// Requires akto-guardrails-executor to be deployed first.
		// Set to "false" for pure async traffic monitoring (zero added latency).
		"APPLY_AKTO_GUARDRAILS": "true",

		// Optional: comma-separated path substrings to apply guardrails on.
		// Leave empty to guard all endpoints. Example: "/api/chat,/api/completions"
		"AKTO_ENDPOINTS_TO_GUARD": "",

		// Your Akto account ID. Find it in: Akto Dashboard → Settings → Account.
		"AKTO_ACCOUNT_ID": "1000000"
	},

	"routes": [
		{
			// Update to match your domain — e.g., "api.yourdomain.com/*"
			"pattern": "*.yourdomain.com/*",
			"zone_name": "yourdomain.com"
		}
	]
}
