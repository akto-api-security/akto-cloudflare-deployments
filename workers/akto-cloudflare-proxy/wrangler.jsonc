{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "akto-cloudflare-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"services": [
		{
			"binding": "MCP",
			"service": "<YOUR_TARGET_WORKER_NAME>"
		},
		{
			"binding": "AKTO_GUARDRAILS",
			"service": "akto-ingest-guardrails"
		},
		{
			"binding": "AKTO_INGEST_GUARDRAILS",
			"service": "akto-ingest-guardrails"
		}
	],
	"vars": {
		"GUARDRAILS_MODE": "async"
	},
	"routes": [
		{
			"pattern": "*.yourdomain.com/*",
			"zone_name": "yourdomain.com"
		}
	]

	/**
	 * Configuration Notes:
	 * 1. Replace <YOUR_TARGET_WORKER_NAME> with the name of your target worker
	 * 2. MCP binding: Proxies all requests to your target worker (REQUIRED)
	 * 3. AKTO_GUARDRAILS binding: For validation in blocked mode (REQUIRED for blocked mode)
	 * 4. AKTO_INGEST_GUARDRAILS binding: For traffic ingestion (OPTIONAL, can use DATA_INGESTION_URL instead)
	 * 5. GUARDRAILS_MODE: Set to "async" (validate in background) or "blocked" (validate before forwarding)
	 * 6. Optional: Add DATA_INGESTION_URL to vars if not using service binding for ingestion
	 * 7. Configure routes above:
	 *    - pattern: Route pattern (e.g., "*.yourdomain.com/*", "api.yourdomain.com/*")
	 *    - zone_name: Your domain name
	 */
}
